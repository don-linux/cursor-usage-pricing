        "auto"
      ],
      "matchers": [
        {
          "type": "exact",
          "value": "auto"
        }
      ],
      "pricing": {
        "input": 1.25,
        "cacheWrite": 1.25,
        "cacheRead": 0.25,
        "output": 6
      },
      "rules": [],
      "warnings": [
        "Auto has fixed token rates regardless of which model Cursor selects behind the scenes.",
        "Auto is exempt from the Teams Cursor Token Rate."
      ],
      "sourceNotes": [
        "Input + Cache Write: $1.25",
        "Output: $6.00",
        "Cache Read: $0.25"
      ]
    },
