{
  "schemaVersion": 1,
  "source": {
    "name": "Cursor Models & Pricing",
    "url": "https://cursor.com/docs/models-and-pricing.md",
    "retrievedAt": "2026-04-29",
    "currency": "USD",
    "unit": "per_1m_tokens"
  },
  "normalization": {
    "notes": [
      "Model effort suffixes such as high, xhigh, extra-high, low, thinking, and max do not change pricing unless the model is an explicit priced variant.",
      "Explicit variants such as fast, mini, nano, codex, image-preview, and 1m are modeled separately when Cursor publishes separate prices.",
      "Use exact aliases first, then matchers. If multiple matchers apply, prefer the most specific model ID."
    ],
    "effortSuffixesIgnoredForPricing": [
      "low",
      "medium",
      "high",
      "xhigh",
      "extra-high",
      "thinking",
      "max"
    ]
  },
  "globalRules": [
    {
      "id": "teams-cursor-token-rate",
      "type": "cursor_token_rate",
      "planScope": "teams",
      "appliesWhen": {
        "auto": false
      },
      "rate": {
        "allTokens": 0.25
      },
      "unit": "per_1m_tokens",
      "sourceNote": "On Teams plans, non-Auto agent requests include a Cursor Token Rate of $0.25 per million tokens."
    },
    {
      "id": "legacy-max-mode-surcharge",
      "type": "surcharge_multiplier",
      "planScope": "legacy_request_based",
      "appliesWhen": {
        "maxMode": true
      },
      "multiplier": 1.2,
      "sourceNote": "On legacy request-based plans, Max Mode adds a 20% surcharge."
    }
  ],
  "models": {
